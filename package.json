{
  "name": "@aiwayds/dsh-tui-pi",
  "version": "2.1.1",
  "description": "pi-style terminal UI for DeepSeek Harness (dsh) — pi-tui look & feel, dsh slash commands, GitHub light/dark themes, powerline footer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fan56/dsh-tui-pi.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "tui",
    "terminal",
    "pi",
    "powerline",
    "ui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./projcache": {
      "types": "./lib/projcache.d.ts",
      "default": "./lib/projcache.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-tui-pi": "bin/dsh-tui-pi"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "scripts",
    "templates",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "link-closure": "node scripts/link-dsh-closure.mjs",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "precheck": "node scripts/link-dsh-closure.mjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke-boot.mjs"
  },
  "dependencies": {
    "@aiwayds/dsh-ask-router": "^0.3.0",
    "@aiwayds/dsh-dcp": "^0.6.0",
    "@aiwayds/dsh-llm-proxy": "^0.3.0",
    "@aiwayds/dsh-llm-stats": "^0.4.0",
    "@aiwayds/dsh-mcp-adapter": "^0.3.0",
    "@aiwayds/dsh-model-sync": "^0.2.1",
    "@aiwayds/dsh-subagent-registry": "^0.5.0",
    "@aiwayds/dsh-web-search-anysearch": "^0.2.0",
    "@earendil-works/pi-tui": "0.84.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-user-questions": ">=0.1.2-alpha.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-user-questions": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@deepseek-ai/dsh-user-questions": "0.1.2-alpha.4",
    "typescript": "~5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "fan56",
  "publishConfig": {
    "access": "public"
  }
}
