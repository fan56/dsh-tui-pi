{
  "name": "@aiwayds/dsh-tui-pi",
  "version": "0.18.1",
  "description": "pi-style terminal UI for DeepSeek Harness (dsh) — pi-tui look & feel, dsh slash commands, GitHub light/dark themes, powerline footer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fan56/dsh-tui-pi.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "tui",
    "terminal",
    "pi",
    "powerline",
    "ui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-tui-pi": "bin/dsh-tui-pi"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "scripts",
    "templates",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "link-closure": "node scripts/link-dsh-closure.mjs",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "precheck": "node scripts/link-dsh-closure.mjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@aiwayds/dsh-dcp": "0.5.1",
    "@aiwayds/dsh-subagent-registry": "0.3.0",
    "@earendil-works/pi-tui": "0.84.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-user-questions": "0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-user-questions": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@deepseek-ai/dsh-user-questions": "0.1.1-rc.2",
    "typescript": "~5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "fan56",
  "publishConfig": {
    "access": "public"
  }
}
