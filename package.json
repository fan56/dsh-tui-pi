{
  "name": "@aiwayds/dsh-tui-pi",
  "version": "2.37.1",
  "description": "A fully-featured pi-style terminal UI for DeepSeek Harness (dsh) — history look-back & fork-at-turn, guided preset switching, live subagent steering, model profiles & themes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fan56/dsh-tui-pi.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "tui",
    "terminal",
    "pi",
    "powerline",
    "ui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./projcache": {
      "types": "./lib/projcache.d.ts",
      "default": "./lib/projcache.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "bin": {
    "dsh-tui-pi": "bin/dsh-tui-pi",
    "dst": "bin/dsh-tui-pi"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "scripts",
    "templates",
    "assets",
    "themes",
    "locales",
    "skills",
    "README.md",
    "LICENSE",
    "icon.svg",
    "locale/*.json"
  ],
  "scripts": {
    "link-closure": "node scripts/link-dsh-closure.mjs",
    "build": "tsc -p tsconfig.json",
    "prebuild": "node scripts/link-dsh-closure.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "precheck": "node scripts/link-dsh-closure.mjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke-boot.mjs"
  },
  "dependencies": {
    "@aiwayds/dsh-ask-router": "^0.7.0",
    "@aiwayds/dsh-dcp": "^0.14.0",
    "@aiwayds/dsh-jev-core": "^0.2.0",
    "@aiwayds/dsh-llm-proxy": "^0.8.1",
    "@aiwayds/dsh-llm-stats": "^0.9.0",
    "@aiwayds/dsh-mcp-adapter": "^0.8.1",
    "@aiwayds/dsh-model-sync": "^0.9.0",
    "@aiwayds/dsh-profile-switch": "^0.4.1",
    "@aiwayds/dsh-subagent-registry": "^0.20.1",
    "@aiwayds/dsh-web-search-anysearch": "^0.9.0",
    "@earendil-works/pi-tui": "0.85.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-user-questions": ">=0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-questions": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.2.2-rc.2",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "fan56",
  "publishConfig": {
    "access": "public"
  }
}
