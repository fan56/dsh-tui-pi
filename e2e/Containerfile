# e2e image: Ubuntu 24.04 + Node 22 + tmux + a global dsh install + the
# plugin tarball built from THIS source tree.
#
# The base image is pulled through the DaoCloud mirror because
# registry-1.docker.io is not reachable from the dev machine's podman VM
# (DNS-poisoned). On a network where docker.io works, drop the
# "docker.m.daocloud.io/" prefix.
FROM docker.m.daocloud.io/library/ubuntu:24.04

ARG NODE_VERSION=22.23.2
# npmmirror's binary mirror is the default: nodejs.org's CDN is not
# reachable from this network's podman VM (same pollution family as the
# docker.io base image above — nodejs.org answers fine from the host).
# On a clean network: --build-arg NODE_DIST_BASE=https://nodejs.org/dist
ARG NODE_DIST_BASE=https://npmmirror.com/mirrors/node
ARG PNPM_VERSION=10.33.0
ARG DSH_VERSION=0.1.0-rc.8

ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm-256color

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils tmux git \
 && rm -rf /var/lib/apt/lists/*

# Node from the official dist tarball — no apt repository dependency,
# arch-agnostic (x64 / arm64).
RUN case "$(uname -m)" in \
      x86_64)  NODE_ARCH=x64 ;; \
      aarch64) NODE_ARCH=arm64 ;; \
      *) echo "unsupported arch: $(uname -m)" >&2; exit 1 ;; \
    esac \
 && curl -fsSL \
      "${NODE_DIST_BASE}/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
      | tar -xJ -C /usr/local --strip-components=1 \
 && node --version

# pnpm + the dsh CLI. The global dsh install must exist BEFORE the plugin
# build: scripts/link-dsh-closure.mjs symlinks the @deepseek-ai/* closure
# from the global dsh install into node_modules so tsc can resolve the
# types (they are not on the public registry in a usable form).
RUN npm install -g --no-fund --no-audit \
      pnpm@${PNPM_VERSION} \
      @deepseek-ai/dsh@${DSH_VERSION} \
 && dsh --version || true

WORKDIR /app

# Build the plugin from source and pack the user-facing tarball into /dist.
# The frozen-lockfile retry covers lockfiles generated on another platform.
COPY . .
RUN (pnpm install --frozen-lockfile || pnpm install) \
 && node scripts/link-dsh-closure.mjs \
 && pnpm build \
 && pnpm pack \
 && mkdir -p /dist && mv *.tgz /dist/ \
 && ls -la /dist/

# The scenario suite is bind-mounted at /e2e by e2e/run-e2e.sh so test logic
# can iterate without an image rebuild.
CMD ["bash", "/e2e/scenarios/run-all.sh"]
